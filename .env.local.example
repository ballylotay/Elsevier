# --- This app's Auth0 tenant ---
AUTH0_SECRET=YOUR_SECRET                 # openssl rand -hex 32
AUTH0_DOMAIN=YOUR_TENANT.us.auth0.com
AUTH0_CLIENT_ID=YOUR_CLIENT_ID
AUTH0_CLIENT_SECRET=YOUR_CLIENT_SECRET
APP_BASE_URL=http://localhost:3000
# AUDIENCE is required for course access: the access token must be a JWT so it can be validated.
AUTH0_AUDIENCE=https://api.elsevier-demo.com
AUTH0_SCOPE=openid profile email offline_access launch:course

# --- Course provider: second (simulated third-party) Auth0 tenant, used for the token exchange ---
PARTNER_AUTH0_DOMAIN=YOUR_PARTNER_TENANT.us.auth0.com
PARTNER_AUTH0_CLIENT_ID=YOUR_PARTNER_CLIENT_ID
PARTNER_AUTH0_CLIENT_SECRET=YOUR_PARTNER_CLIENT_SECRET
PARTNER_AUTH0_AUDIENCE=https://courses.partner-demo.com
PARTNER_AUTH0_SCOPE=                      # optional
# Must match the subject_token_type of the Custom Token Exchange profile on the partner tenant
PARTNER_SUBJECT_TOKEN_TYPE=https://elsevier.com/token-types/app-access-token
